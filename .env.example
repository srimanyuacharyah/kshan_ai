# ==============================================================================
# KSHAN — ENVIRONMENT CONFIGURATION TEMPLATE
# Tagline: "One Moment. Infinite Lives. Your choices create worlds that never existed."
# ==============================================================================
# Instructions: Copy this file to .env and replace placeholders with real values.
# NEVER commit real .env files to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & ENVIRONMENT MODE
# ------------------------------------------------------------------------------
# Options: development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://kshan_user:kshan_quantum_pass@localhost:5432/kshan_db

# Direct sync URL for Alembic migrations if needed:
# SYNC_DATABASE_URL=postgresql://kshan_user:kshan_quantum_pass@localhost:5432/kshan_db

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Generate a strong 64-character secret with: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_secure_random_64_char_hex_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. CORS ORIGINS (Comma-separated list of allowed origins)
# ------------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI GENERATIVE AI & EMBEDDINGS
# ------------------------------------------------------------------------------
# Optional: If omitted or invalid, KSHAN operates in zero-key Deterministic Mock Mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Configurable vector embedding dimension (must match pgvector schema)
EMBEDDING_DIMENSION=768

# Rate limits for expensive generative endpoints (requests per minute)
RATE_LIMIT_AI_RPM=30

# ------------------------------------------------------------------------------
# 6. MODEL CONTEXT PROTOCOL (MCP) SERVICE
# ------------------------------------------------------------------------------
MCP_SERVER_URL=http://localhost:8001/mcp
MCP_TIMEOUT_SECONDS=15.0

# ------------------------------------------------------------------------------
# 7. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# Base API URL used in production (or leave empty for relative /api/v1 proxy)
VITE_API_URL=
